%UNFOLD

\subsection{Conditional Inference on the \txtSNR}
% conditional estimation %FOLDUP
\begin{frame}[fragile]{Conditional Inference Procedure}
Use the polyhedral lemma to test
$\Hyp[0] : \psnr[(\nstrat)] = \psnr[0]$.

\emph{Pro:}
\begin{itemize}
\item 
Inference only operates on \psnr[(\nstrat)], ignores $\psnr[(1)],\psnr[(2)],\ldots,\psnr[(\nstrat-1)]$.
\item
Takes into account correlation of returns.\\
	Together these give higher power.
\item
	The \RMAT need not be positive definite, so in theory this works for $\ssiz \ll\nstrat$.
\end{itemize}
	\emph{Con:}
\begin{itemize}
\item 
	Have to estimate the covariance of \svsr.
\item
The normal approximation $\svsr \approx \normlaw{\cdots}$ may not be good enough.
\item
If $\ssr[(\nstrat)] \approx \ssr[(\nstrat-1)]$, will not take into account
	that you would have selected strategy $(\nstrat-1)$.
\end{itemize}

\end{frame}
%UNFOLD

\subsection{Simulations}

\begin{frame}[fragile]{Simulations}
Test power under the alternative:
\begin{itemize}
	\item Let $m$ strategies have $\psnr=c>0$, and $\nstrat-m$ have $\psnr=-c$.\\
		Test for $m=\nstrat,\nstrat/2,1$.
		Vary $c$.
	\item 
		Measure the rejection probability versus the \txtSNR of strategy
		$(\nstrat)$. (Will be $\pm c$.)
\end{itemize}

<<'motherload_sim_funcs',echo=FALSE,eval=TRUE,cache=TRUE>>=
suppressMessages({
	library(dplyr)
  library(doFuture)
  library(epsiwal)
})

tgen <- function(n,mu,sigma,df) {
  rescal <- sqrt((df-2)/df)
  rescal * mvtnorm::rmvt(n,df=df,delta=mu/rescal,sigma=sigma,type='shifted')
}

dosim <- function(nsim,nday,R,mu,testmu=mu,ret_dist=c('gaussian','t4','t5','t6','t20'),
                  estimate_parms=FALSE,higher_order=FALSE) { 
	ret_dist <- match.arg(ret_dist)
  p <- length(mu)
  zeta <- mu / diag(R)
  if (!estimate_parms) {
    if (higher_order) {
      kapp <- switch(ret_dist,
                     gaussian=1,
                     t4=Inf,
                     t5=3,
                     t6=2,
                     t20=18/16)
      mySigma <- (1/nday) * (R + ((kapp-1)/4) * outer(zeta,zeta,'*') + (kapp/2) * diag(zeta) %*% (R * R) %*% diag(zeta))
    } else {
      mySigma <- (1/nday) * (R + (1/2) * diag(zeta) %*% (R * R) %*% diag(zeta))
    }
  }

  testzeta <- testmu / diag(R)
  generator <- switch(ret_dist,
                      gaussian=function(n) mvtnorm::rmvnorm(n,mean=mu,sigma=R),
                      t4=function(n) tgen(n,mu=mu,sigma=R,df=4),
                      t5=function(n) tgen(n,mu=mu,sigma=R,df=5),
                      t6=function(n) tgen(n,mu=mu,sigma=R,df=6),
                      t20=function(n) tgen(n,mu=mu,sigma=R,df=20))

  A1 <- cbind(-1,diag(p-1))
  these_sims <- replicate(nsim,{
    X <- generator(nday)
    srs <- colMeans(X) / apply(X,2,sd)

    if (estimate_parms) {
      Rhat <- cov2cor(cov(X))
      if (higher_order) {
        kapp <- median(apply(X,2,moments::kurtosis)) / 3
        mySigma <- (1/nday) * (Rhat + ((kapp-1)/4) * outer(srs,srs,'*') + (kapp/2) * diag(srs) %*% (Rhat * Rhat) %*% diag(srs))
      } else {
        mySigma <- (1/nday) * (Rhat + (1/2) * diag(srs) %*% (Rhat * Rhat) %*% diag(srs))
      }
    }

    y <- srs

    # collect the maximum, so reorder the A above
    yord <- order(y,decreasing=TRUE)
    revo <- seq_len(p)
    revo[yord] <- revo

    A <- A1[,revo]
    nu <- rep(0,p)
    nu[yord[1]] <- 1
    b <- rep(0,p-1)

    foo <- epsiwal::pconnorm(y=y,A=A,b=b,eta=nu,mu=testzeta,Sigma=mySigma)
    c(max(srs),foo,zeta[yord[1]])
  })
  data_frame(simvals=as.numeric(these_sims[1,]),
             pvals=as.numeric(these_sims[2,]),
             popvals=as.numeric(these_sims[3,]))
}
multsim <- function(nsim,nday,R,mu,testmu=mu,estimate_parms=FALSE,ret_dist='gaussian',higher_order=FALSE,splitby=32) { 
  if ((nsim > 2*splitby) && require(future.apply,quietly=TRUE)) {
    # do in parallel.
    nper <- table(1 + ((0:(nsim-1) %% splitby))) 
    retv <- future_lapply(nper,
                          dosim,
                          nday=nday,R=R,mu=mu,testmu=testmu,ret_dist=ret_dist,
                          estimate_parms=estimate_parms,higher_order=higher_order) %>%
      bind_rows()
  } else {
    retv <- dosim(nsim=nsim,nday=nday,R=R,mu=mu,testmu=testmu,ret_dist=ret_dist,
            estimate_parms=estimate_parms,higher_order=higher_order)
  }
  retv
}
parsim <- function(nsim,nday,R,mu,testmu=mu,estimate_parms=FALSE,ret_dist='gaussian',higher_order=FALSE,nnodes=7) {
  plan(multicore, workers=nnodes)
  retv <- multsim(nsim=nsim,nday=nday,R=R,
                  mu=mu,testmu=testmu,
                  estimate_parms=estimate_parms,
                  ret_dist=ret_dist,
                  higher_order=higher_order)
  plan(sequential)
  retv
}
ks_sim <- function(rho,nday,nstrat,max_zeta,estimate_parms=FALSE,ret_dist='gaussian',higher_order=FALSE,nsim=100) {
  R <- pmin(diag(nstrat) + rho,1)  
  mu <- seq(0,max_zeta,length.out=nrow(R))
  sim <- parsim(nsim,nday=nday,R=R,mu=mu,ret_dist=ret_dist,
                estimate_parms=estimate_parms,higher_order=higher_order)
  broom::tidy(ks.test(sim$pvals,punif))
}
#sim <- parsim(nsim,nday=nday,R=R,mu=mu,estimate_parms=FALSE,ret_dist='t5')
#plot(ecdf(sim$pvals))

chib_test <- function(xbar2,nstrat,lower.tail=FALSE) {
  cwts <- exp(lchoose(nstrat,0:nstrat) - nstrat * log(2))
  okwt <- (cwts > 1e-9)
  sbdf <- which(okwt) - 1
  sbwt <- cwts[okwt]
  # should check that sum(sbwt) is around 1
  #stopifnot(abs(sum(sbwt) - 1) < 1e-5)
  sum(sbwt * pchisq(xbar2,df=sbdf,lower.tail=lower.tail))
}
# call a bunch of testing procedures
alt_test <- function(nday,mu,nsim=100,rho=0,psnr0=0) {
  nstrat <- length(mu)
  R <- pmin(diag(nstrat) + rho,1)  
  kurty <- 1.0 # assumed

	apart <- sqrt(nday)/sqrt(1-rho)
	bpart <- sqrt(nday) * ((1/sqrt(1-rho+nstrat*rho)) - (1/sqrt(1-rho)))

  # weights from chi-bar square distro
  cwts <- exp(lchoose(nstrat,0:nstrat) - nstrat * log(2))
  okwt <- (cwts > 1e-9)
  sbdf <- which(okwt) - 1
  sbwt <- cwts[okwt]
  # should check that sum(sbwt) is around 1
  stopifnot(abs(sum(sbwt) - 1) < 1e-5)
  cval <- 1/sqrt(1 + (nstrat-1) * rho)
  dval <- sqrt(1-rho)
  xi0 <- cval * psnr0

  # follman's, and redundant to above
  a0 <- (1-rho) + (kurty/2) * psnr0^2 * (1-rho^2)
  a2 <- rho + ((kurty-1)/4) * psnr0^2 + (kurty/2) * psnr0^2 * rho^2
  b0 <- 1 / sqrt(a0)
  #b2 <- (-1 / (nstrat*sqrt(a0))) + (1/nstrat) / sqrt(a0 + nstrat*a2)
  #cval <- b0 + nstrat * b2

  f1 <- nday * nstrat * cval^2
  f2 <- nday * b0^2

  # Hansens cutoff
  spcut <- xi0 - sqrt(2*log(log(nday))/nday)

  # would be great to parallelize this with future_replicate?
  mhtpvals <- replicate(nsim,{
    if (rho == 0) {
      svsr <- SharpeR::rsr(n=nstrat,df=nday-1,zeta=mu,ope=1)
    } else {
      X <- mvtnorm::rmvnorm(nday,mean=mu,sigma=R)
      svsr <- colMeans(X) / apply(X,2,sd)
    }
    xm <- which.max(svsr)
    ssravg <- mean(svsr)
    ssrmax <- max(svsr)

    # this is uncorrected bonferroni p-value, FWIW.
		bonf_pval <- nstrat * SharpeR::psr(ssrmax,df=nday-1,zeta=psnr0,ope=1,lower.tail=FALSE) 

		# do the correction
		corr_stat <- apart * ssrmax + bpart * ssravg
		corr_pval <- nstrat * pnorm(corr_stat,lower.tail=FALSE)

    # convert to 'xi'
    xi <- cval * ssravg + (svsr-ssravg) / dval

    # chibarsquare test, assuming rho=0
    chibs <- (nday) * sum(pmax(xi - xi0,0)^2)
    chibp <- sum(sbwt * pchisq(chibs,df=sbdf,lower.tail=FALSE))

    # follman test
    g2 <- f1 * (ssravg - psnr0)^2 + f2 * sum((svsr - ssravg)^2)
    follp <- pchisq(g2,df=nstrat,lower.tail=FALSE)
    ffollp <- ifelse(ssravg > psnr0,0.5 * follp,1 - 0.5*follp)

    # hansens procedures; 
    nabove <- sum(xi > spcut)
    # chibar-square with loglog adjustment
    llval <- ifelse(nabove > 0,chib_test(chibs,nabove,lower.tail=FALSE),1)
    # bonferroni/SPA p-value, correcting the rho-safe Bonferroni above
    spval <- ifelse(nabove > 0,(nabove/nstrat) * corr_pval,1)

    c(bonf_pval,corr_pval,chibp,ffollp,llval,spval,mu[xm])
  })
  retv <- data.frame(t(mhtpvals)) %>%
    setNames(c('norho_mht','mht','chibarsquare','follman','loglog','spa','popvals')) %>%
    tidyr::gather(key=method,value=pvals,-popvals)

  retv
}
mult_alt_test <- function(nday,mu,nsim=100,rho=0,psnr0=0,splitby=64) {
  if ((nsim > 2*splitby) && require(future.apply,quietly=TRUE)) {
    # do in parallel.
    nper <- table(1 + ((0:(nsim-1) %% splitby))) 
    retv <- future_lapply(nper,
                          alt_test,
                          nday=nday,mu=mu,rho=rho,psnr0=psnr0) %>%
      bind_rows()
  } else {
    retv <- alt_test(nsim=nsim,nday=nday,mu=mu,rho=rho,psnr0=psnr0) 
  }
  retv
}

par_alt_test <- function(nday,mu,nsim=100,rho=0,psnr0=0,nnodes=7) {
  plan(multicore, workers=nnodes)
  retv <- mult_alt_test(nday=nday,mu=mu,
                        nsim=nsim,rho=rho,
                        psnr0=psnr0)
  plan(sequential)
  retv
}
# spawn mu and call the sims
bot_rawsim <- function(nday,nstrat,one_zeta=0,nsim=100,rho=0,
                       do_conde=TRUE,
                       mutype=c('equal','onegood','halfgood','spread')) {
	mutype <- match.arg(mutype)
  mu <- switch(mutype,
               equal=rep(one_zeta,nstrat),
               onegood=c(one_zeta,rep(-one_zeta,nstrat-1)),
               halfgood=c(rep(one_zeta,floor(nstrat/2)),
                          rep(-one_zeta,ceiling(nstrat/2))),
               spread=seq(-one_zeta,one_zeta,length.out=nstrat))
  retv <- par_alt_test(nday=nday,mu=mu,nsim=nsim,rho=rho)
  if (do_conde) {
    R <- pmin(diag(nstrat) + rho,1)  
    retv <- bind_rows(parsim(nsim=nsim,nday=nday,R=R,mu=mu,testmu=rep(0,nstrat)) %>%
                      select(-simvals) %>% 
                      mutate(pvals=1-pvals) %>% 
                      mutate(method='condest'),
                    retv)
  }
  retv
}
# compute the rejection rates
mhtsim <- function(alpha=0.05,...) {
  bot_rawsim(...) %>%
    group_by(method,popvals) %>%
      summarize(rej_rate=mean(pvals < alpha),
                tot_base=n()) %>%
    ungroup() %>%
    arrange(method,popvals)
}
@
<<'sims_vs_mht',dependson=c('motherload_sim_funcs'),echo=FALSE,eval=TRUE,cache=TRUE>>=
# 6cbe48d8-9b1f-4b5e-a439-228082a8a4b4 
suppressMessages({
  library(tidyr)
  library(dplyr)
  library(future)
})

FINAL.VERSION <- TRUE
# actual run the sims
lout <- ifelse(FINAL.VERSION,15,9)
params <- data_frame(one_zeta=seq(0,0.15,length.out=lout)) %>%
  tidyr::crossing(data_frame(mutype=c('onegood','halfgood','equal'))) 

mht_nsim <- ifelse(FINAL.VERSION,1e4,1e3)
mht_nday <- ifelse(FINAL.VERSION,4*252,2*252)
mht_nstrat <- ifelse(FINAL.VERSION,50,24)

registerDoFuture()
plan(multicore,workers=7)
set.seed(1234)
#system.time({
resu <- params %>%
  group_by(one_zeta,mutype) %>%
    summarize(resu=list(mhtsim(nday=mht_nday,nstrat=mht_nstrat,one_zeta=one_zeta,nsim=mht_nsim,mutype=mutype))) %>%
  ungroup() %>%
  unnest()
#})
plan(sequential)
@

<<'power_plotz_one',dependson=c('sims_vs_mht','plot_options'),echo=FALSE,eval=TRUE,cache=TRUE,fig.width=0.87*10,fig.height=0.35*10,out.width="0.87\\textwidth",out.height="0.35\\textwidth">>=
fig_cap <- paste0('The empirical power of the conditional estimation, MHT corrected test, ',
                  "Follman's test, ",
                  "the chi-bar-square test, ",
                  "and the chi-bar-square and MHT tests with Hansen's $\\log\\log$ correction ",
                  "are shown versus the \\txtSNR of the asset with maximum \\txtSR under ",
                  'different arrangements of the vector \\pvsnr. ',
                  'We jitter the points horizontally to distinguish tests with very similar rejection rates. ')

library(ggplot2)
set.seed(1234)
ph <- resu %>%
  filter(method!='norho_mht') %>%  # we are using rho=0, so should be the same
  #filter(method!='follman') %>%  # simplify
  mutate(shapel=case_when(grepl('^condest$',method)   ~ 'cond. est.',
                          grepl('^mht|spa$',method)   ~ 'MHT',
                          grepl('^(chibarsquare|loglog)$',method)  ~ 'chi-bar^2',
                          grepl('^follman$',method)   ~ 'Follman',
                          TRUE ~ 'ERROR')) %>%
  mutate(method=case_when(grepl('^condest$',method)   ~ 'cond. est.',
                          grepl('^mht$',method)       ~ 'MHT',
                          grepl('^chibarsquare$',method)  ~ 'chi-bar^2',
                          grepl('^follman$',method)   ~ 'Follman',
                          grepl('^loglog$',method)    ~ 'Hansen chi-bar^2',
                          grepl('^spa$',method)       ~ 'Hansen SPA',
                          TRUE ~ 'ERROR')) %>%
  mutate(mutype=case_when(mutype=='equal'     ~ 'all-equal',
                          mutype=='halfgood'  ~ 'half-good',
                          mutype=='onegood'   ~ 'one-good',
                          TRUE ~ 'ERROR')) %>%
  mutate(lt=ifelse(grepl('Hansen',method),'yes','no')) %>%
	filter(method %in% c('MHT','Hansen SPA','cond. est.')) %>%
	mutate(method=gsub('Hansen SPA','MHT + Hansen loglog',method)) %>%
	mutate(snr=sqrt(252)*popvals) %>%
  ggplot(aes(snr,rej_rate,color=method)) + # ,linetype=lt))  +
  geom_line(alpha=0.8) + geom_jitter(aes(shape=method),height=0,width=0.001) + 
  facet_grid(.~mutype) + 
  geom_hline(yintercept=0.05,linetype=2,alpha=0.5) + 
  geom_vline(xintercept=0,linetype=2,alpha=0.3) + 
  scale_y_continuous(labels=scales::percent) + 
  labs(x='signal noise ratio',
       y='rejection rate at nominal 0.05 level',
       color='method',
       shape='method', #shape='statistic',
       #linetype='Hansen correction?',
       title='Rejection rate of tests')
print(ph)
@
\end{frame}


\nocite{student08ttest}
\subsection{Conclusion}
\begin{frame}{Conclusion}%FOLDUP

Future directions:
\begin{itemize}
\item Strategies are often selected based on in-sample fitting, so that
	$\ssr^2$ follows a $\chi^2$ distribution.\\
	What is the polyhedral lemma for correlated $\chi^2$ variates?
\item Can we adapt Conditional Inference to test 
\begin{equation*}
  \label{hyp:more_max_snr_conditional}
  \Hyp[0] : \psnr[(\nstrat)] = \psnr[(\nstrat-1)] = \ldots = \psnr[(\nstrat-m)] = \psnr[0]\quad\mbox{versus}\quad \Hyp[1] : \psnr[(\nstrat)] \vee 
	\psnr[(\nstrat-1)] \vee
	\ldots
	\psnr[(\nstrat-m)] > \psnr[0].
\end{equation*}
\item Where else can we use Hansen's loglog trick?
\end{itemize}

Learn more:
\begin{itemize}
\item \emph{Conditional inference on the asset with maximum Sharpe ratio}.  \cite{pav2019maxsharpe}
\item \emph{The Sharpe Ratio: Statistics and Applications}.  \cite{pav_the_book}
\end{itemize}
\end{frame}%UNFOLD
