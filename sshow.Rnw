\section{Conditional Inference}
\subsection{Polyhedral Lemma}

% conditional estimation %FOLDUP
\begin{frame}[fragile]{Conditional Inference}
\emph{Idea:} perform inference only on the selected asset,
	conditioning on the selection criterion.\\

{\bf Polyhedral Lemma:} (\citet{lee2013exact})
	If $\vect{z} \sim \normlaw{\pvmu,\pvsig}$, 
	and you want to test $\trAB{\vect{\nu}}{\vect{z}}$ 
	conditional on $\AAA\vect{z}\le\bbb$:\\
$\trAB{\vect{\nu}}{\vect{z}}$ is a one-dimensional truncated normal:
$$
\trAB{\vect{\nu}}{\vect{z}} \sim \condtwo{\normlaw{\mu,\sigma^2}}{\,l \le \trAB{\vect{\nu}}{\vect{z}} \le h}.
$$

