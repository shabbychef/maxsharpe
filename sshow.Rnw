\section{Background}%FOLDUP

\subsection{The \txtSR}
%\subsection{\substext}

% a common problem %FOLDUP
\begin{frame}[allowframebreaks]{The \txtSR}
%Consider the quantitative investment problem:\\
\begin{centblock}{0.94\textwidth}{The Quantitative Investment Problem}
%\begin{quote}
Given some assets,
how do you select one to invest in,
based only on the distribution of returns?
%\end{quote}
\end{centblock}
%This problem has two forms:
\begin{enumerate}
\item How would you invest if you knew the population distribution (mean, variance, \etc) of returns? 
\item How would you invest if you have to estimate the distribution?
\end{enumerate}
\citet{Sharpe:1966} proposed a ``reward-to-variability'' ratio to compare
mutual funds:
\begin{equation*}
\boxed{
\ssr = \frac{\smu}{\ssig}
}
\end{equation*}
A heuristic based on investors preference for higher returns and lower `risk'.\\
Proposed earlier by \citet{roySafety1952}:
by Chebyshev's inequality,
\begin{equation*}
\boxed{
\probof{\mbox{returns} < 0} \le \wrapParens{\frac{\pmu}{\psig}}^{-2}
}
\end{equation*}
So optimize $\fracc{\pmu}{\psig}$ to minimize probability of a loss.\\

%Risk-adverse investors align their preferences with \emph{stochastic dominance}.
%\begin{itemize}
%\item A collection of partial orders on probability distributions.
%\item $A$ (first order) stochastically dominates $B$ if $\Pof{A > x} \ge \Pof{B > x}$ for all $x$.
%\item Generally these prefer higher mean returns, and lower variance of returns.
%\item Stochastic dominance does not form a total order: given two distributions
	%neither may dominate the other.
%\end{itemize}
%Quantitative investment requires a total order on investments: a way to compare any two investments.

%\framebreak
\end{frame}
\begin{frame}[allowframebreaks]{Mean Variance Tradeoff}

Risk adverse investors prefer higher mean return and lower variance of returns:

<<'ret_thing',echo=FALSE,eval=TRUE,cache=TRUE,fig.width=0.75*14,fig.height=0.42*14,out.width="0.75\\textwidth",out.height="0.42\\textwidth">>=
# return n returns with a fixed sample mean and sample standard deviation:
fixx <- function(x,mu,sig) {
	z <- (x - mean(x)) / sd(x)
	z * sig + mu 
}
nday <- 252*4
#params <- crossing(tibble(mu=seq(0.06,0.24,length.out=4)/252),
									 #tibble(sig=sqrt(seq(0.01,0.07,length.out=4)/252)))
params <- crossing(tibble(mu=seq(0.08,0.24,length.out=3)/252),
									 tibble(sig=sqrt(seq(0.01,0.09,length.out=3)/252)))
set.seed(5678)
rets <- params %>%
	group_by(mu,sig) %>%
		summarize(arx=list(fixx(rnorm(nday,mean=mu,sd=sig),mu=mu,sig=sig))) %>%
	ungroup() %>%
	unnest(arx) %>%
	group_by(mu,sig) %>%
		mutate(value=exp(cumsum(arx))) %>%
		mutate(day=seq_len(n())) %>%
	ungroup()

ph <- rets %>% 
	mutate(mean=252*mu,variance=252*sig^2) %>%
	ggplot(aes(day,value,group=interaction(mean,variance))) + 
	geom_line(color='red') + 
	facet_grid(mean~variance,labeller=label_both,scales='fixed') + 
	#theme_void() + 
	labs(x='days',
			 y='value',
			 title='Hypothetical investments')
print(ph)
@
\end{frame}
\section{Overfitting}
\subsection{Problem Formulation}
\begin{frame}[allowframebreaks]{Overfitting}

\begin{center}
		%\includegraphics[scale=0.35]{extra/xkcd_1570.png}
		\includegraphics[width=0.5\linewidth]{media/syllogism.jpg}
\end{center}

Overfitting is a serious problem in quantitative investing:
\begin{itemize}
	\item Profitable trading strategies are probably rare.
	\item Availability of data and computing power enable us to consider thousands of strategies.
	\item Long historical data may not be available or relevant: ``wide data''.
	\item You collect out-of-sample data very slowly: one day per day.
\end{itemize}

\end{frame}

\begin{frame}[allowframebreaks]{The Overfitting Problem}

Suppose you observe $\nstrat$ strategies' historical returns, with
Sharpe ratios 
$$
\ssr[(1)] \le \ssr[(2)] \le \ldots \le \ssr[(\nstrat)]
$$
What can we say about the strategy associated with \ssr[(\nstrat)]?

<<'pick_best',echo=FALSE,eval=TRUE,cache=TRUE,fig.width=0.67*14,fig.height=0.31*14,out.width="0.67\\textwidth",out.height="0.31\\textwidth">>=
nstrat <- 100
nday <- 252*4
sg <- 0.013
sr <- 1 / sqrt(252)
mu <- sg*sr

set.seed(1234)
foo <- tibble(rets=rnorm(nday*nstrat,mean=mu,sd=sg)) %>%
	mutate(strat=rep(1:nstrat,nday)) %>%
	group_by(strat) %>%
		mutate(day=seq_len(n())) %>%
	ungroup() %>%
	arrange(strat,day) %>%
	group_by(strat) %>%
		mutate(mtm=exp(cumsum(rets))) %>%
	ungroup() %>%
	arrange(strat,day) %>%
	group_by(strat) %>%
		mutate(sr=sqrt(252) * mean(rets) / sd(rets)) %>%
	ungroup() %>%
	mutate(isbest=sr==max(sr))

ph <- foo %>% 
	filta(!isbest) %>%
	ggplot(aes(day,mtm,group=strat)) + 
	#geom_line(aes(color=isbest)) + 
	geom_line(color='grey40',alpha=0.6) +
	geom_line(data=foo %>% filta(isbest),color='red') + 
	scale_y_log10() + 
	#theme_void() + 
	labs(x='days',
			 y='value',
			 title='Hypothetical investments')
print(ph)
@




<<'show_mtms',echo=FALSE,eval=FALSE,cache=TRUE,fig.width=0.75*10,fig.height=0.3*10,out.width="0.75\\textwidth",out.height="0.3\\textwidth">>=
nday <- 252*4
sigx <- 0.010
sigy <- 2.9*sigx
mu <- (1.4 / sqrt(252)) * sigx
#set.seed(1309)
set.seed(1429)
dat <- tibble::tibble(x=rnorm(nday,mean=mu,sd=sigx),
											y=rnorm(nday,mean=mu,sd=sigy)) %>%
	mutate(x=x + mean(y) - mean(x)) %>%
	mutate(A=exp(cumsum(x)),B=exp(cumsum(y))) %>%
	mutate(day=seq_len(n())) %>%
	select(day,A,B) %>%
	tidyr::gather(key=investment,value=value,A,B)
	

ph <- dat %>%
	ggplot(aes(day,value,color=investment)) +
	geom_line() + 
	labs(x='days',
			 y='value',
			 title='two hypothetical investments')
print(ph)
@

\end{frame}
%UNFOLD
%UNFOLD


\subsection{Inference on Asset with Maximal \txtSNR}
%\subsection{\substext}

% a common problem %FOLDUP
\begin{frame}{Inference on the Asset with Maximal Signal-Noise Ratio}

%Two approaches to the problem:\\
{\bf Classical Multiple Hypothesis Testing (MHT)}\hspace{2mm}\\
	\begin{itemize}
		\item
Test \emph{all} strategies, correcting for multiple tests:
%Test the hypothesis
\begin{equation}
\label{hyp:max_snr_uit}
\Hyp[0] : \forall i\,\psnr[i] = \psnr[0]\quad\mbox{versus}\quad \Hyp[1] : \exists i: \psnr[i] > \psnr[0].
\end{equation}
		\item
			Classically via the Bonferroni correction: perform $\nstrat$ tests at the $\alpha/\nstrat$ level.
		\item
			Advances by \citet{White:2000} (bootstrapping) and \citet{Hansen:2005} (Studentizing, ``loglog trick'').
	\end{itemize}
MHT has limitations:
\begin{itemize}
	\item If you invest in strategy \nstrat, you are not interested in strategies $1,2,\ldots,\nstrat -1$.
	\item Correlation among strategy returns can reduce power.
	\item Bootstrapping will not scale to 1000's of strategies.
\end{itemize}

{\bf Conditional Inference}\\
\begin{itemize}
	\item
Test \emph{only the selected strategy}:
%\begin{equation}
  %\label{hyp:snr_conditional_test}
  %\Hyp[0] : \acondb{\psnr[(\nstrat)] = \psnr[0]}{\ssr \ge \psnr[1]}\quad\mbox{versus}\quad \Hyp[1] : \psnr[(\nstrat)] > \psnr[0],
%\end{equation}
\begin{equation}
  \label{hyp:max_snr_conditional}
  \Hyp[0] : \psnr[(\nstrat)] = \psnr[0]\quad\mbox{versus}\quad \Hyp[1] : \psnr[(\nstrat)] > \psnr[0].
\end{equation}
\item
	No classical formulation in statistics.
\item
	Should we be concerned with $\psnr[(\nstrat-1)]$?
\end{itemize}
\end{frame}
%UNFOLD
%UNFOLD

\section{MHT}
\subsection{Multiple Hypothesis Testing Correction}

\begin{frame}[fragile]{Correlated Returns}
Often you are testing variations on a strategy, causing correlated returns.\\
The \txtSRs are correlated as well.
<<'pick_best_rho',echo=FALSE,eval=TRUE,cache=TRUE,fig.width=0.67*14,fig.height=0.31*14,out.width="0.67\\textwidth",out.height="0.31\\textwidth">>=
nstrat <- 100
nday <- 252*4
sg <- 0.013
sr <- 1 / sqrt(252)
mu <- sg*sr
rho <- 0.9

set.seed(5678)
foo <- tibble(rets=rnorm(nday*nstrat,mean=mu,sd=sg)) %>%
	mutate(strat=rep(1:nstrat,nday)) %>%
	group_by(strat) %>%
		mutate(day=seq_len(n())) %>%
	ungroup() %>%
	arrange(strat,day) %>%
	group_by(day) %>%
		mutate(avg=first(rets)) %>%
	ungroup() %>%
	mutate(rets=rho*avg + sqrt(1-rho^2)*rets) %>%
	group_by(strat) %>%
		mutate(mtm=exp(cumsum(rets))) %>%
	ungroup() %>%
	arrange(strat,day) %>%
	group_by(strat) %>%
		mutate(sr=sqrt(252) * mean(rets) / sd(rets)) %>%
	ungroup() %>%
	mutate(isbest=sr==max(sr))

ph <- foo %>% 
	filta(!isbest) %>%
	ggplot(aes(day,mtm,group=strat)) + 
	#geom_line(aes(color=isbest)) + 
	geom_line(color='grey40',alpha=0.4) +
	geom_line(data=foo %>% filta(isbest),color='red') + 
	scale_y_log10() + 
	#theme_void() + 
	labs(x='days',
			 y='value',
			 title='Hypothetical investments')
print(ph)
@
\end{frame}

% bonferroni
\begin{frame}[fragile]{Bonferroni on Correlated Returns}
When \RMAT is correlation of returns, then
\begin{equation}
\svsr \approx 
%\normlaw{\pvsnr,\oneby{\ssiz}\wrapParens{\RMAT +
	%\frac{1}{2} \Mdiag{\pvsnr} \wrapParens{\RMAT\hadm\RMAT} \Mdiag{\pvsnr}}}.
%\label{eqn:apx_srdist_elliptical}
\normlaw{\pvsnr,\oneby{\ssiz}\RMAT}.
\label{eqn:even_more_apx_srdist_elliptical}
\end{equation}
	\vspace{-5mm}
\begin{itemize}
	\item
		For rank one correlation model $\RMAT=\rhoR$, 
		under the null
$\Hyp[0]:\pvsnr=\psnr[0]\vone$, 
$$
\svsr - \psnr[0]\vone \sim \normlaw{\vzero,\makerho{a_2}{a_1}}.
$$
\item
The covariance is ``order preserving.'' 
The \kth{\nstrat} element of the following is the largest:
$$
\wrapParens{\makerho{a_2}{a_1}}^{-\halff}\wrapParens{\svsr - \psnr[0]\vone} \sim \normlaw{\vzero,\eye}.
$$
\item
	The rank one model is good enough by Slepian's Lemma: take $\rho$ to be minimum correlation.
\item
	\citet{Hansen:2005} showed you don't have to count all \nstrat strategies.\\
		Can ignore the duds if you define the cutoff properly.
\end{itemize}

\end{frame}


