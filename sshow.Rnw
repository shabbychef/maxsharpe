	%\vspace{-5mm}
%\begin{itemize}
%\item
%Max condition $\ssr[1] \ge \ssr[2], \ssr[1] \ge \ssr[3], \ldots$ can
%be expressed as $\AAA\svsr\le\bbb$.
%\item Inference on $\psnr[1]$ of the form $\trAB{\etav}{\pvsnr}$,
	%with $\etav=\basev[1]$.
%\end{itemize}
%Use results of Lee \etal \cite{lee2013exact},
%to perform conditional inference on $\trAB{\etav}{\yvec}$, with
